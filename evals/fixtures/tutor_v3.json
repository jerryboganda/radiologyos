      "expected": {"cited_labels_subset_of": ["S1"], "summary_never_cited": true},
      "assertions": ["schema_valid", "every_segment_cited", "citations_resolve_to_retrieved", "summary_not_citable"]
    },
    {
      "case_id": "tutor-answer-prefers-reading-page",
      "prompt": "tutor_answer/v3.yaml",
      "route": "reason",
      "tenant_id": "20000000-0000-0000-4000-800000000002",
      "input": {
        "question": "Explain the key point of this page.",
