{
  "realm": "radbrain",
  "enabled": true,
  "displayName": "radbrain",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessTokenLifespanForImplicitFlow": 300,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "attributes": {
    "updateProfileFirstLoginMode": "off"
  },
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Default learner role. Membership remains authoritative in the database."
      },
      {
        "name": "editor",
        "description": "May work the editor queues for their tenant."
      },
      {
        "name": "org_admin",
        "description": "Tenant administrator."
      },
      {
        "name": "superadmin",
        "description": "Platform administrator."
      }
    ]
  },
  "defaultRoles": ["offline_access", "uma_authorization", "student"],
  "clients": [
    {
      "clientId": "radbrain-web",
      "name": "radbrain web",
      "description": "SvelteKit server-side OIDC client. Confidential; the secret is rotated after import and never committed.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "https://radiologyos.polytronx.com",
      "baseUrl": "/",
      "adminUrl": "",
      "webOrigins": [
        "https://radiologyos.polytronx.com",
        "http://localhost:3000"
      ],
      "redirectUris": [
        "https://radiologyos.polytronx.com/*",
        "http://localhost:3000/auth/callback",
        "http://localhost:3000/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://radiologyos.polytronx.com/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email"],
      "optionalClientScopes": ["address", "offline_access", "phone", "microprofile-jwt"],
      "protocolMappers": [
        {
          "name": "radbrain-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "radbrain-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
  "users": []
}
