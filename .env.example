# Application
APP_ENV=dev
DEBUG=false
API_PREFIX=/v1
BILLING_ENABLED=false

# Database. Use a separate migration role in deployed environments.
DATABASE_URL=postgresql+asyncpg://radbrain_app:radbrain_app@localhost:5432/radbrain
DATABASE_MIGRATOR_URL=postgresql+asyncpg://radbrain_migrator:radbrain_migrator@localhost:5432/radbrain

# Rust and S3-compatible object storage
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=radbrain
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1

# Auth
OIDC_ISSUER=http://localhost:8080/realms/radbrain
OIDC_JWKS_URL=
OIDC_CLIENT_ID=radbrain-web
OIDC_AUDIENCE=radbrain-api
OIDC_CLIENT_SECRET=radbrain-web-secret
COOKIE_SECURE=false

# Vector dimensions are explicit configuration, never hard-coded in migrations.
EMBED_DIM=1024
IMAGE_EMBED_DIM=1152
PIPELINE_VERSION=1

# Model routes are configured in packages/models/models.yaml.
MODELS_CONFIG_PATH=packages/models/models.yaml
LITELLM_BASE_URL=
LITELLM_API_KEY=
ALLOW_UNGROUNDED_DEFAULT=false
# ADR 0013 v2: semantic grounding judge on tutor answers (default true).
TUTOR_GROUNDING_JUDGE=true
CORE_TENANT_ID=00000000-0000-0000-0000-000000000001
